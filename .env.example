# Copy to .env and fill in
# Get a key: https://aistudio.google.com/apikey (or Google AI Studio)
GEMINI_API_KEY=
# Optional: same as GEMINI_API_KEY if you prefer this name
# GOOGLE_API_KEY=

# Model — if 404, run: python -c "from google import genai; ... models.list()". If 429, try another model or billing.
GEMINI_MODEL=gemini-2.5-flash

# Max characters per text chunk sent to the model
CHUNK_MAX_CHARS=12000
CHUNK_OVERLAP=400
